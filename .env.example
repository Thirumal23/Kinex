# KINEX Environment Configuration Template
# Copy this file to .env and fill in sensitive credentials if applicable.
# NEVER commit the active .env file containing real passwords or tokens.

# Server Settings
KINEX_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# Vision Pipeline Settings
YOLO_MODEL_PATH=configs/yolo26n-pose.yaml
YOLO_PRETRAINED=false
YOLO_DEVICE=cpu

# Hardware Serial Settings
ESP32_SERIAL_PORT=COM3
ESP32_BAUD_RATE=115200

# Optional Wi-Fi / Remote Gateway Settings (Future Phase)
ESP32_WIFI_SSID=
ESP32_WIFI_PASSWORD=
WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=8765
